generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  gender    String
  age       Int
  city      String   @default("西宁")
  bio       String
  avatarUrl String
  wechatId  String
  createdAt DateTime @default(now())

  swipesFrom Swipe[]   @relation("SwipeFrom")
  swipesTo   Swipe[]   @relation("SwipeTo")
  matchesA   Match[]   @relation("MatchA")
  matchesB   Match[]   @relation("MatchB")
  messages   Message[]
}

model Swipe {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  direction  String
  createdAt  DateTime @default(now())

  fromUser User @relation("SwipeFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("SwipeTo", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA  User    @relation("MatchA", fields: [userAId], references: [id])
  userB  User    @relation("MatchB", fields: [userBId], references: [id])
  thread Thread?

  @@unique([userAId, userBId])
}

model Thread {
  id        String   @id @default(cuid())
  matchId   String   @unique
  createdAt DateTime @default(now())

  match    Match     @relation(fields: [matchId], references: [id])
  messages Message[]
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id])
  sender User   @relation(fields: [senderId], references: [id])
}
